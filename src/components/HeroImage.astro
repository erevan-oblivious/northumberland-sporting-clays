---
interface Props {
  title?: string;
  lead?: string;
  description?: string;
  bgImage: string;
  bgImageMobile: string;
  
  // Call to Action Buttons
  primaryButtonText?: string;
  primaryButtonLink?: string;
  secondaryButtonText?: string;
  secondaryButtonLink?: string;
  whatsappUrl?: string;
  whatsappText?: string;

  // Custom Tint Opacity (e.g. "75%" or "80%")
  tintOpacity?: string;
}

const {
  title = "Main Headline Goes Here",
  lead,
  description,
  bgImage,
  bgImageMobile,
  primaryButtonText = "Call Now",
  primaryButtonLink,
  secondaryButtonText,
  secondaryButtonLink,
  whatsappUrl,
  whatsappText = "Enquire on WhatsApp",
  tintOpacity = "25%",
} = Astro.props;
---

<section 
  class="hero-image-banner" 
  style={{ 
    '--bg-image': `url('${bgImage}')`,
    '--bg-image-mobile': bgImageMobile ? `url('${bgImageMobile}')` : `url('${bgImage}')`,
    '--tint-opacity': tintOpacity
  }}
>
  <!-- 1. Dark Tinted Overlay -->
  <div class="hero-overlay" aria-hidden="true"></div>

  <!-- 2. Foreground Content Container (Restored) -->
  <div class="hero-content">
    <div class="hero-text-group">
      <h1 class="hero-title">{title}</h1>
      {lead && <p class="hero-lead">{lead}</p>}
      {description && <p class="hero-description">{description}</p>}
    </div>

    {(primaryButtonLink || secondaryButtonLink || whatsappUrl) && (
      <div class="hero-actions">
        {whatsappUrl && (
          <a 
            href={whatsappUrl} 
            class="btn btn-primary"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={whatsappText}
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.205 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 4.762 1.213 4.96c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            <span>{whatsappText}</span>
          </a>
        )}

        {primaryButtonLink && (
          <a href={primaryButtonLink} class="btn btn-primary">
            <span>{primaryButtonText}</span>
          </a>
        )}

        <a 
          href="#about" 
          class="btn-secondary" 
          aria-label="Scroll to next section"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 5v14M19 12l-7 7-7-7"/>
          </svg>
        </a>
      </div>
    )}
  </div>
</section>

<style>
  .hero-image-banner {
    height: 100vh;
    width: 100%;
    box-sizing: border-box;
    position: relative;
    padding: 8.5rem 1.5rem 4rem;
    background-image: var(--bg-image);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    display: flex;
    flex-direction: column;
  }

@media (max-width: 768px), (max-width: 1024px) and (orientation: portrait) {
    .hero-image-banner {
      background-image: var(--bg-image-mobile);
    }
  }

  /* Layer 1: Brand Tint Overlay */
  .hero-overlay {
    position: absolute;
    inset: 0;
    background-color: color-mix(in srgb, #000000 var(--tint-opacity, 25%), transparent);
    z-index: 1;
  }

  /* Layer 2: Text & Actions Wrapper */
  .hero-content {
    position: relative;
    z-index: 2;
    max-width: var(--max-width-wide);
    margin: 0 auto;
    text-align: center;
    flex: 1;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
  }

  .hero-text-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    width: 100%;
    margin-top: 1rem;
  }

  .hero-title {
    font-family: var(--font-family-base);
    font-size: clamp(2.5rem, 5vw, 3.85rem);
    line-height: 1.1;
    color: var(--text-muted);
    max-width: 900px;
    margin: 0;
    font-weight: 700;
  }

  .hero-lead {
    font-size: clamp(1.25rem, 2.5vw, 1.5rem);
    font-weight: 500;
    color: var(--text-muted);
    line-height: 1.4;
    max-width: 800px;
    margin: 0;
  }

  .hero-description {
    font-size: var(--font-size-lg);
    line-height: 1.65;
    color: var(--text-muted);
    max-width: 760px;
    margin: 0;
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5rem;
    width: 100%;
    margin-top: auto;
  }

  /* Standardized Template Button Styles */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    padding: 0.875rem 1.75rem;
    font-size: var(--font-size-base);
    font-weight: 600;
    border-radius: var(--radius-sm, 6px);
    text-decoration: none;
    transition: all 0.2s ease-in-out;
    width: 100%;
    max-width: 320px;
  }

  .btn-primary {
    background-color: var(--bg-secondary);
    color: var(--text-muted);
    border: 1px solid var(--bg-secondary);
  }

  .btn-primary:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    color: var(--text-muted);
    background-color: transparent;
    border: 1.5px solid var(--text-muted);
    transition: all 0.2s ease-in-out;
    animation: bounce 2s infinite;
  }

  .btn-secondary:hover {
    background-color: rgba(255, 255, 255, 0.1);
  }

  /* Bounce Animation Keyframes */
  @keyframes bounce {
    0%, 20%, 50%, 80%, 100% {
      transform: translateY(0);
    }
    40% {
      transform: translateY(6px);
    }
    60% {
      transform: translateY(3px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .btn-secondary {
      animation: none;
    }
  }
</style>