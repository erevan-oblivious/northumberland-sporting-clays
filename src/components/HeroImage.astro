---
interface Props {
  title?: string;
  lead?: string;
  description?: string;
  bgImage: string;
  bgImageMobile: string;
  
  // Call to Action Buttons
  primaryButtonText?: string;
  primaryButtonLink?: string;
  primaryButtonText2?: string;
  primaryButtonLink2?: string;

  // Custom Tint Opacity (e.g. "75%" or "80%")
  tintOpacity?: string;
}

const {
  title = "Main Headline Goes Here",
  lead,
  description,
  bgImage,
  bgImageMobile,
  primaryButtonText = "Text for primary button",
  primaryButtonLink,
  primaryButtonText2 = "Text for secondary primary button",
  primaryButtonLink2,
  tintOpacity = "25%",
} = Astro.props;
---

<section 
  class="hero-image-banner" 
  style={{ 
    '--bg-image': `url('${bgImage}')`,
    '--bg-image-mobile': bgImageMobile ? `url('${bgImageMobile}')` : `url('${bgImage}')`,
    '--tint-opacity': tintOpacity
  }}
>
  <!-- 1. Dark Tinted Overlay -->
  <div class="hero-overlay" aria-hidden="true"></div>

  <!-- 2. Foreground Content Container (Restored) -->
  <div class="hero-content">
    <div class="hero-text-group">
      <h1 class="hero-title">{title}</h1>
      {lead && <p class="hero-lead">{lead}</p>}
      {description && <p class="hero-description">{description}</p>}
    </div>

    {(primaryButtonLink || primaryButtonLink2) && (
      <div class="hero-actions">

        {primaryButtonLink && (
          <a href={primaryButtonLink} class="btn btn-primary">
            <svg 
              xmlns="http://www.w3.org/2000/svg" 
              width="20" 
              height="20" 
              viewBox="0 0 24 24" 
              fill="none" 
              stroke="currentColor" 
              stroke-width="2" 
              stroke-linecap="round" 
              stroke-linejoin="round"
              aria-hidden="true"
              >
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
            <span>{primaryButtonText}</span>
          </a>
        )}

        {primaryButtonLink2 && (
          <a href={primaryButtonLink2} class="btn btn-primary2">
            <svg 
              xmlns="http://www.w3.org/2000/svg" 
              width="20" 
              height="20" 
              viewBox="0 0 24 24" 
              fill="none" 
              stroke="currentColor" 
              stroke-width="2" 
              stroke-linecap="round" 
              stroke-linejoin="round"
              aria-hidden="true"
              >
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <span>{primaryButtonText2}</span>
          </a>
        )}

        <a 
          href="#about" 
          class="btn-secondary" 
          aria-label="Scroll to next section"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 5v14M19 12l-7 7-7-7"/>
          </svg>
        </a>
      </div>
    )}
  </div>
</section>

<style>
  .hero-image-banner {
    height: 100vh;
    width: 100%;
    box-sizing: border-box;
    position: relative;
    padding: 8.5rem 1.5rem 4rem;
    background-image: var(--bg-image);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    display: flex;
    flex-direction: column;
  }

@media (max-width: 768px), (max-width: 1024px) and (orientation: portrait) {
    .hero-image-banner {
      background-image: var(--bg-image-mobile);
    }
  }

  /* Layer 1: Brand Tint Overlay */
  .hero-overlay {
    position: absolute;
    inset: 0;
    background-color: color-mix(in srgb, #000000 var(--tint-opacity, 25%), transparent);
    z-index: 1;
  }

  /* Layer 2: Text & Actions Wrapper */
  .hero-content {
    position: relative;
    z-index: 2;
    max-width: var(--max-width-wide);
    margin: 0 auto;
    text-align: center;
    flex: 1;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
  }

  .hero-text-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    width: 100%;
    margin-top: 1rem;
  }

  .hero-title {
    font-family: var(--font-family-base);
    font-size: clamp(2.5rem, 5vw, 3.85rem);
    line-height: 1.1;
    color: var(--text-muted);
    max-width: 900px;
    margin: 0;
    font-weight: 700;
  }

  .hero-lead {
    font-size: clamp(1.25rem, 2.5vw, 1.5rem);
    font-weight: 500;
    color: var(--text-muted);
    line-height: 1.4;
    max-width: 800px;
    margin: 0;
  }

  .hero-description {
    font-size: var(--font-size-lg);
    line-height: 1.65;
    color: var(--text-muted);
    max-width: 760px;
    margin: 0;
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    width: 100%;
    margin-top: auto;
  }

  /* Standardized Template Button Styles */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    padding: 0.875rem 1.75rem;
    font-size: var(--font-size-base);
    font-weight: 600;
    border-radius: var(--radius-sm, 6px);
    text-decoration: none;
    transition: all 0.2s ease-in-out;
    width: 100%;
    max-width: 320px;
  }

  .btn-primary {
    background-color: var(--bg-secondary);
    color: var(--text-muted);
    border: 1px solid var(--bg-secondary);
  }

  .btn-primary:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  .btn-primary2 {
    background-color: var(--bg-secondary);
    color: var(--text-muted);
    border: 1px solid var(--bg-secondary);
  }

  .btn-primary2:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }


  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    color: var(--text-muted);
    background-color: transparent;
    border: 1.5px solid var(--text-muted);
    transition: all 0.2s ease-in-out;
    animation: bounce 2s infinite;
  }

  .btn-secondary:hover {
    background-color: rgba(255, 255, 255, 0.1);
  }

  /* Bounce Animation Keyframes */
  @keyframes bounce {
    0%, 20%, 50%, 80%, 100% {
      transform: translateY(0);
    }
    40% {
      transform: translateY(6px);
    }
    60% {
      transform: translateY(3px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .btn-secondary {
      animation: none;
    }
  }
</style>