---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  transparentHeader?: boolean; /* Allows for optional transparent header for homepage */
}

const { 
  title = "Northumberland Sporting Clays", 
  description = "Clay pigeon shooting for beginners, groups and fun days out",
  transparentHeader = false
} = Astro.props;
---

<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
</head>

<body>
    
<a href="#main-content" class="skip-link">Skip to main content</a>

<header class={`header ${transparentHeader ? 'header-transparent' : ''}`}>
  <div class="header-inner">
      <a href="/" class="logo-link">
        <span class="logo-title">Northumberland Sporting Clays</span>
      </a>

    <!-- Hamburger Toggle Button -->
    <button class="hamburger" id="hamburger-btn" aria-label="Toggle navigation menu" aria-expanded="false">
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </button>

    <!-- Navigation Menu -->
    <nav class="nav-links" id="nav-menu">
      <a href="/">Home</a>
      <a href="/about">About</a>
      <a href="/services">Services</a>
      <a href="/contact">Contact</a>
    </nav>
  </div>

</header>

<script>
  const hamburgerBtn = document.getElementById('hamburger-btn');
  const navMenu = document.getElementById('nav-menu');

  if (hamburgerBtn && navMenu) {
    hamburgerBtn.addEventListener('click', () => {
      const isOpen = navMenu.classList.toggle('is-active');
      hamburgerBtn.classList.toggle('is-active');
      hamburgerBtn.setAttribute('aria-expanded', isOpen.toString());
    });
  }
</script>

<main class="main" id="main-content">

  <slot />

</main>

<footer class="footer">
  <hr class="divider-full" />
  
  <p>Business name, company registration number, charity registration number</p>
  <p>&copy; {new Date().getFullYear()} Business Name. All rights reserved.</p>

  <nav class="footer-nav" aria-label="Legal navigation">
    <a href="/privacy">Privacy Policy</a>
    <a href="/cookies">Cookie Policy</a>
    <a href="/accessibility">Accessibility Statement</a>
  </nav>
</footer>

</body>

</html>