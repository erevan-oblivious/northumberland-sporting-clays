---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import HeroImage from '../components/HeroImage.astro';
import TickList from '../components/TickList.astro';
import NavGrid from '../components/NavGrid.astro';

const shootingHighlights = [
    "Spend a day in the beautiful Northumberland countryside",
    "An opportunity to try something completely different and learn something new",
    "A basic shooting level can be mastered in a short space of time",
    "Inclusive and enjoyable regardless of age, fitness and ability",
    "Book individual lessons, group lessons, stag and hen does, or corporate away days",
    "A great day out for friends, families or colleagues!",
  ];

---

<BaseLayout 
  title="Home | Northumberland Sporting Clays"
  description="Experience the thrill of clay pigeon shooting in the beautiful Northumberland countryside."
  transparentHeader={true}
>

<HeroImage 
    title="Clay Pigeon Shooting in Northumberland"
    lead="Shooting Lessons for beginners, groups and fun days out"
    bgImage="/shooting-lesson-4.jpg"
    bgImageMobile="/shooting-lesson-2.jpg"
    tintOpacity="25%"
    primaryButtonText="Book by email"
    primaryButtonLink="mailto:northumberlandsportingclays@aol.com"
    primaryButtonText2="Book by phone"
    primaryButtonLink2="tel:+447709084699"
/>

<TickList 
  eyebrow="We cater for everyone from personal lessons to group days out"
  title="Why Choose Clay Pigeon Shooting?"
  items={shootingHighlights} />

<hr class="divider-full" />

<NavGrid 
eyebrow="Explore"
title="Most Popular"
/>

<script src="https://elfsightcdn.com/platform.js" async></script>
<div class="elfsight-app-079c3ccc-3f90-477a-a597-ee042468a59b" data-elfsight-app-lazy></div>

</BaseLayout>