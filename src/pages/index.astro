---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import HeroImage from '../components/HeroImage.astro';
import TickList from '../components/TickList.astro';
import NavGrid from '../components/NavGrid.astro';
import GoogleReviews from '../components/GoogleReviews.astro';

---

<BaseLayout 
  title="Webpage Name | Business Name"
  description="Webpage Description"
  transparentHeader={true}
>

<HeroImage 
    title="Clay Pigeon Shooting in Northumberland"
    lead="Shooting Lessons for beginners, groups and fun days out"
    bgImage="/shooting-lesson-4.jpg"
    bgImageMobile="/shooting-lesson-2.jpg"
    tintOpacity="25%"
    primaryButtonText="Book Now"
    primaryButtonLink="/contact"
    secondaryButtonText="Add downward arrow"
    secondaryButtonLink="/"
/>

<TickList />

<hr class="divider-full" />

<NavGrid 
eyebrow="Explore"
title="Most Popular"
/>

<GoogleReviews />

</BaseLayout>